# --- Fechas que te interesan (OPCIONAL) ---
# Formato YYYY-MM-DD separadas por coma. Te aviso si alguna esta disponible.
# Si lo dejas vacio o lo borras, te aviso de la cita MAS PROXIMA disponible.
TARGET_DATES=2026-05-22

# --- Correo con Resend (OBLIGATORIO) ---
# Crea una API key gratis en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Remitente. Sin dominio propio usa onboarding@resend.dev (solo envia a tu correo de Resend).
EMAIL_FROM=DEKRA Watcher <onboarding@resend.dev>
# A donde te llega el aviso (debe ser el correo con el que registraste Resend).
EMAIL_TO=josepfhlearn@gmail.com

# --- Ubicaciones a revisar (OPCIONAL) ---
# Formato Nombre:locationId separadas por coma. Por defecto: Alajuela y Puntarenas.
# LOCATIONS=Alajuela:4e130e21-02b8-4158-a7fa-7c446cb9bd2c,Puntarenas:94801ed6-96ff-4247-956d-77451609a767

# --- Dedup: backend de estado (OPCIONAL) ---
# Por defecto usa un archivo local (.state/available.json). No necesitas hacer nada.
# Solo si quisieras correr el dedup en Vercel, configura Upstash (https://upstash.com):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Endpoint Vercel opcional (solo si usas api/check.ts) ---
# Texto secreto para proteger el endpoint. No se usa en el flujo de GitHub Actions.
# CRON_SECRET=

# --- Ajustes avanzados de DEKRA (OPCIONAL) ---
# Solo cambialos si DEKRA modifica sus IDs. Tienen valores por defecto.
# DEKRA_TENANT_ID=81795580-f3e6-4ee0-8274-38f3b42598f9
# DEKRA_PRODUCT_ID=d382c5cc-f92c-449c-8f5d-ea82afe286a9
# Cookies por si el endpoint llegara a exigirlas (normalmente no hace falta).
# DEKRA_COOKIE=

# Ventana de busqueda (OPCIONAL). Por defecto: desde hoy hasta +1 mes.
# START_DATE=2026-06-01
# END_DATE=2026-07-06
