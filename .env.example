# --- Que citas vigilar ---
# El bot de Telegram manda: /buscar, /parar, /dias N y /buscar <ubicacion> cambian esto
# en caliente. Las variables de aqui son solo los valores iniciales.
# Hay tres modos; se elige por prioridad: TARGET_DATES > ventana de dias > cita mas proxima.
#
# 1) Ventana corta rodante (RECOMENDADO para cazar cancelaciones): vigila de hoy a +N dias
#    y avisa de CUALQUIER fecha nueva con cupos en esos dias. Nunca se vence.
WINDOW_DAYS=3
#
# 2) Fechas concretas, separadas por coma. Cada elemento puede ser una fecha o un rango "..":
#      2026-06-15                          una fecha
#      2026-05-22..2026-05-30              un rango (ambos extremos incluidos)
#      2026-05-22..2026-05-30,2026-06-15   rango + fecha suelta
# TARGET_DATES=
#
# 3) Si ambas estan vacias: te aviso de la cita MAS PROXIMA disponible por ubicacion.

# --- Canales de aviso ---
# Necesitas configurar AL MENOS UNO: Telegram (gratis) o correo (Resend). Pueden ser ambos.
# Si no defines NOTIFY_CHANNELS, se usan los canales cuyas credenciales esten presentes.
#   NOTIFY_CHANNELS=telegram          solo Telegram
#   NOTIFY_CHANNELS=email             solo correo
#   NOTIFY_CHANNELS=email,telegram    ambos
# NOTIFY_CHANNELS=

# --- Telegram (RECOMENDADO, gratis) ---
# 1. En Telegram abre @BotFather, manda /newbot y sigue los pasos. Te da un token.
# 2. Abre tu bot nuevo en Telegram y mandale cualquier mensaje (ej. "hola").
# 3. Corre: npm run telegram:chatid   -> te imprime tu TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Varios ids separados por coma si quieres avisar a mas personas (cada una debe escribirle al bot).
# Solo estos chats pueden darle ordenes al bot (/buscar, /parar...).
TELEGRAM_CHAT_ID=123456789
# Secreto para el webhook del bot (api/telegram.ts). Inventa un texto largo al azar y pon el
# mismo en Vercel. Luego registra el webhook: npm run telegram:webhook -- https://TU-APP.vercel.app
TELEGRAM_WEBHOOK_SECRET=
# Cuantos horarios listar por fecha en el mensaje (default 8).
# TELEGRAM_MAX_TIMES=8

# --- Comportamiento del bot (OPCIONAL, todos tienen default) ---
# MAX_LOCATIONS=3          estaciones vigiladas a la vez
# EXPIRE_DAYS=14           la busqueda se apaga sola a los N dias (0 = nunca)
# HEARTBEAT_HOUR=7         hora local del "sigo buscando" diario (-1 = apagado)
# FAIL_ALERT_THRESHOLD=5   fallos seguidos antes de avisar que DEKRA no responde
# DEKRA_RETRIES=2          reintentos por llamada ante 429/5xx

# --- Correo con Resend (OPCIONAL si usas Telegram) ---
# Crea una API key gratis en https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Remitente. Sin dominio propio usa onboarding@resend.dev (solo envia a tu correo de Resend).
# EMAIL_FROM=DEKRA Watcher <onboarding@resend.dev>
# A donde te llega el aviso (debe ser el correo con el que registraste Resend).
# EMAIL_TO=tu-correo@gmail.com

# --- Ubicaciones que el bot puede elegir (OPCIONAL) ---
# Por defecto las 16 estaciones de DEKRA Costa Rica (ver lib/config.ts). Cuales vigilar se
# decide con el bot (/buscar Alajuela). Solo define esto si quieres acotar la lista:
# LOCATIONS=Alajuela:4e130e21-02b8-4158-a7fa-7c446cb9bd2c,Puntarenas:94801ed6-96ff-4247-956d-77451609a767

# --- Dedup: backend de estado ---
# En local usa un archivo (.state/available.json) y no necesitas nada.
# En Vercel es OBLIGATORIO Upstash Redis (gratis): https://console.upstash.com
#   Crea una base "Redis" y copia REST URL y REST TOKEN de la pestaña "REST API".
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx

# --- Endpoint en Vercel (api/check.ts) ---
# Texto secreto largo e inventado para proteger el endpoint. cron-job.org lo manda en
# el header "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=

# --- Ajustes avanzados de DEKRA (OPCIONAL) ---
# Solo cambialos si DEKRA modifica sus IDs. Tienen valores por defecto.
# DEKRA_TENANT_ID=81795580-f3e6-4ee0-8274-38f3b42598f9
# DEKRA_PRODUCT_ID=d382c5cc-f92c-449c-8f5d-ea82afe286a9
# Cookies por si el endpoint llegara a exigirlas (normalmente no hace falta).
# DEKRA_COOKIE=

# Ventana de busqueda (OPCIONAL). Por defecto: desde hoy hasta +1 mes.
# START_DATE=2026-06-01
# END_DATE=2026-07-06
